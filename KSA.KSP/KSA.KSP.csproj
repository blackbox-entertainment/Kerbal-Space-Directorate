<Project Sdk="Microsoft.NET.Sdk">
  <!-- Thin adapter between KSA.Core and Kerbal Space Program. -->

  <PropertyGroup>
    <!-- All game assemblies come from the dev install pointed to by the KSPDIR environment variable. -->
    <KspManaged>$(KSPDIR)\KSP_x64_Data\Managed</KspManaged>
    <KspGameData>$(KSPDIR)\GameData</KspGameData>
    <RepoGameData>$(MSBuildThisFileDirectory)..\GameData\KSA</RepoGameData>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KSA.Core\KSA.Core.csproj" />
  </ItemGroup>

  <!-- Game references. Private=false so they are never copied to output or into GameData. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Needed by DialogGUI / PopupDialog (TextAnchor lives in TextRenderingModule; layouts use UnityEngine.UI). -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(KspManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(KspManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Needed by ApplicationLauncherButton (exposes an Animator). -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(KspManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityEngine.Input (auto-recovery cancel keys). -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(KspManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- GUILayout for the in-flight HUD and GUIUtility clipboard. -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(KspManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- UnityWebRequest for the LLM transport. -->
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(KspManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Fail early with a clear message if KSPDIR is missing or wrong. -->
  <Target Name="KsaCheckKspDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(KSPDIR)' == ''"
           Text="KSPDIR environment variable is not set. Set it to your KSP dev install, e.g. E:\KSP_dev, then restart the terminal." />
    <Error Condition="'$(KSPDIR)' != '' And !Exists('$(KspManaged)\Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll not found under $(KspManaged). Check that KSPDIR points at a KSP install." />
  </Target>

  <!-- Post-build: deploy plugin DLLs, Configs, and Textures into the dev install. -->
  <Target Name="KsaDeploy" AfterTargets="Build" Condition="'$(KSPDIR)' != ''">
    <ItemGroup>
      <KsaPluginFiles Include="$(OutDir)KSA.Core.dll;$(OutDir)KSA.KSP.dll" />
      <KsaConfigFiles Include="$(RepoGameData)\Configs\**\*" Exclude="$(RepoGameData)\Configs\**\.gitkeep" />
      <KsaTextureFiles Include="$(RepoGameData)\Textures\**\*" Exclude="$(RepoGameData)\Textures\**\.gitkeep" />
    </ItemGroup>
    <MakeDir Directories="$(KspGameData)\KSA\Plugins;$(KspGameData)\KSA\Configs;$(KspGameData)\KSA\Textures" />
    <Copy SourceFiles="@(KsaPluginFiles)" DestinationFolder="$(KspGameData)\KSA\Plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(KsaConfigFiles)" DestinationFiles="@(KsaConfigFiles->'$(KspGameData)\KSA\Configs\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(KsaTextureFiles)" DestinationFiles="@(KsaTextureFiles->'$(KspGameData)\KSA\Textures\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="[KSA] Deployed KSA.Core.dll, KSA.KSP.dll, Configs and Textures to $(KspGameData)\KSA" />
  </Target>
</Project>
